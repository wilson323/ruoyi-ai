# 复制为 .env 后填写真实值；.env 已 gitignore，禁入版本库
IPD_DB_URL=jdbc:mysql://<db-host>:3306/ipd?useUnicode=true&characterEncoding=utf8&serverTimezone=GMT%2B8&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true
IPD_DB_USER=ipd_app
IPD_DB_PASSWORD=
IPD_JWT_SECRET_KEY=

# Actuator 健康检查沿用原 Basic 认证，使用独立监控凭据
IPD_MONITOR_USERNAME=
IPD_MONITOR_PASSWORD=

# 使用现有模型配置的原加密主密钥，不在部署时生成或轮换
IPD_AIMODEL_ENCRYPT_KEY=

# 显式使用本次构建的镜像标签，例如 ipd-backend:<git-sha>；留空沿用 compose 默认
IPD_BACKEND_IMAGE=

# AI 查表使用独立只读账号；账号和密码必填，URL 留空复用 IPD_DB_URL
IPD_DB_AGENT_URL=
IPD_DB_AGENT_USER=
IPD_DB_AGENT_PASSWORD=
