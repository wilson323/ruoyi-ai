<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.ruoyi</groupId>
        <artifactId>ruoyi-modules</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ruoyi-ipd</artifactId>

    <description>
        ipd IPD 产品经理管理系统业务模块
    </description>

    <dependencies>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-redis</artifactId>
            <version>${agentscope.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-common-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-common-mybatis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-common-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-common-log</artifactId>
        </dependency>

        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-common-idempotent</artifactId>
        </dependency>

        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-common-ratelimiter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-common-security</artifactId>
        </dependency>

        <!-- AiModelConfigService（P3-A批）字段加密需要 EncryptUtils；版本随 BOM -->
        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-common-encrypt</artifactId>
        </dependency>

        <!-- ROOT-R2-P0-2：NotificationDispatcher 异步重试队列依赖 Redisson 延迟队列 -->
        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-common-redis</artifactId>
        </dependency>

        <!-- W20-B：Notification 中间件化 EMAIL 真实通道依赖 Spring Boot Mail（JavaMailSender） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- AI-STRAT-2 统一 AI 调用层：AiGateway 使用共享 AgentScope 模型与嵌入装配，版本由父 POM 统一 -->


        <!-- R233 节点智能体：**仅**取 ruoyi-chat 的智能体配置契约（IAgentService#queryEnabledOptions
             + AgentVo{agentName,systemPrompt,status}），按命名约定 IPD-<动作码> 解析节点指令。
             复用 AgentScope 模型装配，不另建模型调用路径、
             不用 MCP ToolProvider：节点执行统一走本模块已治理的 AiGenerationService.generate()
             （SSRF 前置 / 预算预检 / Semaphore 限流 / RAG / 重试 / 落库 / 审计 7 道），
             另起第二条 LLM 路径会全部绕过 = AGENTS.md 禁止的双轨。
             依据：docs/ipd-系统说明/R233-生命周期节点智能体接线设计-20260927.md §1 裁决 A/B。 -->
        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-chat</artifactId>
        </dependency>

        <!-- W20-B：Notification 中间件化 WEBSOCKET 真实通道依赖 ruoyi-common-websocket -->
        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-common-websocket</artifactId>
        </dependency>

        <!-- 任务 2（2026-09-10）：IpdSseController 复用 SseEmitterManager 做用户维度多连接管理 -->
        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-common-sse</artifactId>
        </dependency>

        <!-- 任务 3a-3（2026-09-10，禁止双轨）：IpdMenuController 复用基线 ISysMenuService/ISysUserService
             查 sys_user.user_id（按 persons.username）后调 selectMenuTreeByUserId 拿前端路由；
             ruoyi-system 是 lib module（非独立 SpringBoot），加依赖只入类路径不引启动冲突。 -->
        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-system</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion><groupId>org.skyscreamer</groupId><artifactId>jsonassert</artifactId></exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 构建收口卡 c7767e3a（2026-09-06 晚）：P4-2.1 临时排除块（ContributionService 编译排除 +
                 ComplianceServiceTest / ContributionServiceTest 测试排除）已全部移除，模块回归无排除自洽构建；
                 排除成因与验证证据见看板该卡注记。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- [2026-09-08 治理] 本段曾被三个卡各自「临时」追加，累积豁免 5 个测试类，
                         且旧注释自称「仅在 worktree 内追加排除，不影响 main 分支 HEAD 字节」——实际
                         已随 4feb8ec9 / 221f6c30 / f1ce2db7 进 main 并长期生效。后果：这 5 个类不编译、
                         不执行、一份 surefire 报告不出，mvn 依旧 BUILD SUCCESS；214 个 *Test.java 只编出
                         209 个 class，任何红名单比对都看不见它们（静默跳过即假绿）。

                         本轮实测已撤销其中 3 条（Api03AcceptanceTest / DefectBAdviceAcceptanceTest /
                         IpdAuthChangePasswordExceptionTest）：豁免理由（W20-B「兄弟会话在途编译错误」）
                         早已消解，撤销后编译通过、测试回归，净增 16 个测试（1893 → 1909）且红数未增。
                         撤销同时暴露出 Api03AcceptanceTest 的 stub 仍打在 requireInternal() 上，而
                         Controller 在 SEC-AUTH-DEADLOCK 修复中已改调 requireInternalEvenIfPasswordScope()
                         ——实现漂移被豁免掩盖，已修（该类 5/5 绿）。

                         [2026-09-08 OD-AM-06 收尾] 最后 2 条（KpiSharedConfirmControllerTest /
                         P312AcceptanceTest）编译错误已修复并撤销豁免，本 testExcludes 块整体删除，
                         214 个 *Test.java 首次全部编译执行、零豁免。修复：前者对齐 MyBatis-Plus
                         insert/updateById 重载（裸 any() → any(Entity.class)）、补 lambda 列名缓存
                         TableInfo 引导、修 matcher 混用与一处滞后 stub；后者补 SharedKpiController
                         构造器第三个依赖。基线 exempt_class 两行同步删除，台账 OD-AM-06 翻为已决。 -->
                </configuration>
            </plugin>

            <!-- P1-1（D 轮 D4 §7.2，2026-09-29）：Surefire 零测试门，防 0-test 假绿。
                 根 pom 按 <groups>${profiles.active}</groups> 做 tag 过滤（dev profile activeByDefault），
                 一旦 profile/tag 不匹配（如 -Dprofiles.active=nothing 或切 prod profile），全部测试被
                 静默跳过且 BUILD SUCCESS——本轮实测复现：Tests run: 0 + BUILD SUCCESS（假绿实证）。
                 修复两件套（仅本模块，不波及无测试的兄弟模块）：
                 ① groups combine.self="override" 清空 tag 过滤——本模块 @Tag("dev") 测试不再依赖
                    profile 注入，任何 profile 下都执行；
                 ② failIfNoTests=true 零测试门——过滤/发现结果为 0 个测试时直接转红，不再假绿。
                 验证证据：docs/ipd-系统说明/验收/D轮-生产就绪独立验证-20260929/
                 P1-1-Surefire零测试门修复验证-20260929.md -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <groups combine.self="override"/>
                    <failIfNoTests>true</failIfNoTests>
                </configuration>
            </plugin>

            <!-- AgentScope 单轨内核（2026-10-02）：本模块经 ruoyi-chat 传递引入 io.agentscope:*，
                 agentscope-core 走 okhttp-jvm 5.3.2，与仓内其余传递依赖的 okhttp 4.12.0 同含 okhttp3/*
                 → 运行态重复类冲突。okhttp 全家已在树根 pom dependencyManagement 钉版 5.3.2
                 （键名 okhttp.version，G1 PoC 已封），此处补模块级重复类门禁，与 ruoyi-chat /
                 ruoyi-common-chat 同一套规则，避免「钉版被后续依赖悄悄推翻」无人发现。
                 豁免簇与 ruoyi-chat 一致（swagger-annotations / commons-logging，非 okhttp3，
                 属存量、不在本关射程）；okhttp3 簇不豁免 → 必红。
                 门禁出处：.claude/skills/agentscope-harness/scripts/verify.sh C7。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <dependencies>
                    <dependency>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>extra-enforcer-rules</artifactId>
                        <version>1.8.0</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <fail>true</fail>
                    <rules>
                        <banDuplicateClasses>
                            <!-- fail-fast 语义(findAllDuplicates=false):发现第一个未豁免重复簇即红 -->
                            <ignoreWhenIdentical>true</ignoreWhenIdentical>
                            <findAllDuplicates>false</findAllDuplicates>
                            <ignoreClasses>
                                <ignoreClass>io/swagger/v3/oas/annotations/*</ignoreClass>
                                <ignoreClass>org/apache/commons/logging/*</ignoreClass>
                            </ignoreClasses>
                        </banDuplicateClasses>
                    </rules>
                </configuration>
                <executions>
                    <execution>
                        <id>ban-okhttp3-duplicate-classes</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
