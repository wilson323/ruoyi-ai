+package org.ruoyi.ipd.agent.servicebridge;
+import io.agentscope.core.message.*;
+import io.agentscope.extensions.aistio.model.AgentTaskAssignment;
+import org.ruoyi.ipd.agent.dto.AgentRunCreateReq;
+import org.ruoyi.ipd.agent.service.ProjectAgentRunService;
+import org.ruoyi.ipd.service.IpdCopilotAccess;
+import reactor.core.publisher.*;
+import java.time.Duration;
+import java.util.*;
+
+/** Dispatches exclusively through existing IPD create/get; never calls another agent/model. */
+public final class ProjectAgentOriginalTaskRunner implements ProjectAgentOfficialTaskRelay.OriginalRunExecutor {
+    private final ProjectAgentRunService runs;private final IpdCopilotAccess access;
+    private final ProjectAgentServiceTaskStarter.TrustedBindingResolver bindings;
+    private final AgentTaskAssignment assignment;private final ProjectAgentTaskPreparations preparations;
+    private final Duration poll,deadline;
+    public ProjectAgentOriginalTaskRunner(ProjectAgentRunService runs,IpdCopilotAccess access,
+        ProjectAgentServiceTaskStarter.TrustedBindingResolver bindings,AgentTaskAssignment assignment,
+        ProjectAgentTaskPreparations preparations,Duration poll,Duration deadline){
+        this.runs=Objects.requireNonNull(runs);this.access=Objects.requireNonNull(access);this.bindings=Objects.requireNonNull(bindings);
+        this.assignment=Objects.requireNonNull(assignment);this.preparations=Objects.requireNonNull(preparations);
+        this.poll=Objects.requireNonNull(poll);this.deadline=Objects.requireNonNull(deadline);
+        if(poll.isZero()||poll.isNegative()||deadline.isZero()||deadline.isNegative())throw new IllegalArgumentException("Positive timing required");}
+    public Mono<Msg> execute(ProjectAgentOfficialTaskRelay.PreparedTask task){return Mono.defer(()->{
+        var bound=bindings.resolve(assignment);access.requireVisible(bound.actor(),bound.projectId());var r=bound.request();
+        String input=task.input().msgs().stream().map(Msg::getTextContent).filter(Objects::nonNull).collect(java.util.stream.Collectors.joining("\n\n"));
+        if(input.isBlank())return Mono.error(new IllegalArgumentException("Official task input missing"));
+        String key=ProjectAgentServiceTaskStarter.idempotencyKey(assignment);
+        preparations.publish(bound.actor(),bound.projectId(),key,task);
+        var req=new AgentRunCreateReq(r.capabilityPackCode(),r.capabilityPackVersion(),r.modelConfigId(),r.skillNames(),r.toolIds(),r.actionCode(),input,key,r.productLineId(),r.requirementId(),r.previousRunId(),r.targetDocumentId(),r.baseVersionId());
+        Long id;
+        try{id=Long.valueOf(runs.create(bound.actor(),bound.projectId(),req).runId());bindings.recordRun(assignment,bound,id);}
+        catch(RuntimeException e){preparations.release(key);return Mono.error(new IllegalStateException("Original IPD task dispatch failed"));}
+        return Flux.interval(Duration.ZERO,poll).onBackpressureLatest().concatMap(tick->Mono.fromCallable(()->{access.requireVisible(bound.actor(),bound.projectId());return runs.get(bound.actor(),id);}).subscribeOn(reactor.core.scheduler.Schedulers.boundedElastic()))
+            .filter(run->Set.of("SUCCEEDED","FAILED","CANCELLED").contains(run.status())).next().timeout(deadline)
+            .flatMap(run->{if(!"SUCCEEDED".equals(run.status()))return Mono.error(new IllegalStateException("Original IPD execution "+run.status().toLowerCase(Locale.ROOT)));
+                return Mono.just(Msg.builder().role(MsgRole.ASSISTANT).textContent("Original IPD execution finished; official submitted outcome governs task completion.").generateReason(io.agentscope.core.message.GenerateReason.MODEL_STOP).build());})
+            .doOnCancel(()->runs.cancel(bound.actor(),id)).doFinally(signal->preparations.release(key));
+    });}
+}
