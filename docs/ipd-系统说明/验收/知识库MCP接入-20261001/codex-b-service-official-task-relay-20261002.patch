+package org.ruoyi.ipd.agent.servicebridge;
+import io.agentscope.core.agent.RuntimeContext;
+import io.agentscope.core.tool.Toolkit;
+import io.agentscope.extensions.aistio.adapter.AgentTaskToolContext;
+import io.agentscope.extensions.aistio.adapter.AgentTaskOutcome;
+import org.ruoyi.ipd.agent.domain.IpdAgentRun;
+import org.ruoyi.ipd.security.IpdActor;
+import org.ruoyi.ipd.service.IpdCopilotAccess;
+import java.util.*;
+import java.util.concurrent.ConcurrentHashMap;
+
+/** Trusted pre-create dispatch rendezvous, not a Task API or persistent business authority. */
+public final class ProjectAgentTaskPreparations {
+    private record Entry(IpdActor actor,Long projectId,String tenantId,ProjectAgentOfficialTaskRelay.PreparedTask task) { }
+    private final Map<String,Entry> entries=new ConcurrentHashMap<>();
+    private final IpdCopilotAccess access;
+    public ProjectAgentTaskPreparations(IpdCopilotAccess access){this.access=Objects.requireNonNull(access);}
+    void publish(IpdActor actor,Long projectId,String key,ProjectAgentOfficialTaskRelay.PreparedTask task){
+        var entry=new Entry(actor,projectId,access.requireVisible(actor,projectId),task);
+        Entry previous=entries.putIfAbsent(key,entry);
+        if(previous!=null&&(!previous.actor().id().equals(actor.id())||!previous.projectId().equals(projectId)))throw new SecurityException("Task preparation collision");
+    }
+    public Optional<List<String>> findPlannedToolIds(IpdActor actor,Long projectId,String key){
+        if(!entries.containsKey(key))return Optional.empty();
+        return Optional.of(plannedToolIds(actor,projectId,key));
+    }
+    public List<String> plannedToolIds(IpdActor actor,Long projectId,String key){Entry e=required(actor,projectId,key);return List.copyOf(e.task().tools().keySet());}
+    private Entry required(IpdActor actor,Long projectId,String key){Entry e=entries.get(key);String tenant=access.requireVisible(actor,projectId);
+        if(e==null||!e.actor().id().equals(actor.id())||!e.projectId().equals(projectId)||!e.tenantId().equals(tenant))throw new SecurityException("Unbound original task run");return e;}
+    /** Called on the original built agent before governance wraps every actual tool. */
+    public void install(IpdActor actor,IpdAgentRun row,Toolkit originalTools,RuntimeContext originalContext){
+        Entry e=required(actor,row.getProjectId(),row.getIdempotencyKey());
+        if(!e.actor().id().equals(row.getPersonId())||!e.tenantId().equals(row.getTenantId()))throw new SecurityException("Task run owner mismatch");
+        RuntimeContext task=e.task().officialContext();
+        originalContext.put(AgentTaskToolContext.class,task.get(AgentTaskToolContext.class));
+        originalContext.put(AgentTaskOutcome.State.class,task.get(AgentTaskOutcome.State.class));
+        originalContext.put("agentTaskManaged",Boolean.TRUE);
+        originalContext.put("teamLeader",task.get("teamLeader"));
+        originalContext.put(io.agentscope.harness.agent.subagent.task.TaskRepository.SUPPRESS_COMPLETION_CALLBACK,Boolean.TRUE);
+        e.task().tools().values().forEach(tool -> originalTools.registerAgentTool(new io.agentscope.core.tool.AgentTool() {
+            public String getName(){return tool.getName();}
+            public String getDescription(){return tool.getDescription();}
+            public Map<String,Object> getParameters(){return tool.getParameters();}
+            public boolean isReadOnly(){return tool.isReadOnly();}
+            public Boolean getStrict(){return tool.getStrict();}
+            public Map<String,Object> getOutputSchema(){return tool.getOutputSchema();}
+            public boolean isReturnDirect(){return tool.isReturnDirect();}
+            public reactor.core.publisher.Mono<io.agentscope.core.message.ToolResultBlock> callAsync(io.agentscope.core.tool.ToolCallParam param){
+                return reactor.core.publisher.Mono.defer(()->{
+                    required(actor,row.getProjectId(),row.getIdempotencyKey());
+                    var runtime=param.getRuntimeContext();var bound=runtime==null?null:runtime.get(AgentTaskToolContext.class);
+                    var expected=task.get(AgentTaskToolContext.class);
+                    if(bound==null||expected==null||!expected.taskId().equals(bound.taskId())||!expected.taskToken().equals(bound.taskToken()))
+                        return reactor.core.publisher.Mono.error(new SecurityException("Task tool context mismatch"));
+                    return tool.callAsync(param);
+                });
+            }
+        }));
+    }
+    void release(String key){entries.remove(key);}
+}
