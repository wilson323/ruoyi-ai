+package org.ruoyi.ipd.agent.servicebridge;
+import io.agentscope.extensions.aistio.adapter.*;
+import io.agentscope.extensions.aistio.model.AgentTaskAssignment;
+import io.agentscope.extensions.aistio.transport.CollaborationClient;
+import io.agentscope.harness.agent.HarnessAgent;
+import org.ruoyi.ipd.agent.service.ProjectAgentRunService;
+import org.ruoyi.ipd.service.IpdCopilotAccess;
+import reactor.core.publisher.Mono;
+import java.time.Duration;
+import java.util.*;
+
+/** Public SDK lifecycle with an IPD dispatch-only middleware; no second business task API. */
+public final class ProjectAgentOfficialTaskExecution implements AgentTaskStarter {
+    @FunctionalInterface public interface DispatchCarrierFactory {
+        /** Host-owned authorized workspace/full builder; must install relay before any model execution. */
+        HarnessAgent create(AgentTaskAssignment assignment,ProjectAgentOfficialTaskRelay relay);
+    }
+    private final CollaborationClient client;private final ProjectAgentRunService runs;
+    private final IpdCopilotAccess access;private final ProjectAgentServiceTaskStarter.TrustedBindingResolver bindings;
+    private final ProjectAgentTaskPreparations preparations;private final DispatchCarrierFactory carrierFactory;
+    private final Duration poll,deadline;
+    public ProjectAgentOfficialTaskExecution(CollaborationClient client,ProjectAgentRunService runs,IpdCopilotAccess access,
+        ProjectAgentServiceTaskStarter.TrustedBindingResolver bindings,ProjectAgentTaskPreparations preparations,
+        DispatchCarrierFactory carrierFactory,Duration poll,Duration deadline){
+        this.client=Objects.requireNonNull(client);this.runs=Objects.requireNonNull(runs);this.access=Objects.requireNonNull(access);
+        this.bindings=Objects.requireNonNull(bindings);this.preparations=Objects.requireNonNull(preparations);
+        this.carrierFactory=Objects.requireNonNull(carrierFactory);this.poll=Objects.requireNonNull(poll);this.deadline=Objects.requireNonNull(deadline);}
+    public Mono<Void> start(AgentTaskAssignment assignment){return Mono.defer(()->{
+        var bound=bindings.resolve(assignment);access.requireVisible(bound.actor(),bound.projectId());
+        var envelope=client.taskContext(assignment.agentTaskId(),assignment.taskToken());Set<String> actions=new LinkedHashSet<>();
+        for(var action:envelope.path("availableActions"))actions.add(action.asText());
+        var relay=new ProjectAgentOfficialTaskRelay(assignment.agentTaskId(),actions,
+            ()->access.requireVisible(bound.actor(),bound.projectId()),
+            new ProjectAgentOriginalTaskRunner(runs,access,bindings,assignment,preparations,poll,deadline));
+        return Mono.using(()->carrierFactory.create(assignment,relay),
+            carrier->new HarnessAgentTaskStarter(()->carrier,client).start(assignment),HarnessAgent::close);
+    }).subscribeOn(reactor.core.scheduler.Schedulers.boundedElastic());}
+}
