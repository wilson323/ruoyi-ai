+package org.ruoyi.ipd.agent.servicebridge;
+import io.agentscope.core.agent.*;
+import io.agentscope.core.event.*;
+import io.agentscope.core.middleware.*;
+import io.agentscope.core.tool.AgentTool;
+import io.agentscope.extensions.aistio.adapter.AgentTaskToolContext;
+import io.agentscope.extensions.aistio.adapter.AgentTaskOutcome;
+import reactor.core.publisher.*;
+import java.util.*;
+import java.util.function.Function;
+
+/** Official onAgent extension: dispatch carrier never calls a model; only original IPD runner executes. */
+public final class ProjectAgentOfficialTaskRelay implements MiddlewareBase {
+    public record PreparedTask(AgentInput input,RuntimeContext officialContext,Map<String,AgentTool> tools) { }
+    @FunctionalInterface public interface OriginalRunExecutor { Mono<io.agentscope.core.message.Msg> execute(PreparedTask task); }
+    @FunctionalInterface public interface CurrentAuthority { void requireAuthorized(); }
+    private final String taskId;
+    private final Set<String> officialActions;
+    private final CurrentAuthority authority;
+    private final OriginalRunExecutor originalRunner;
+    public ProjectAgentOfficialTaskRelay(String taskId,Set<String> officialActions,CurrentAuthority authority,OriginalRunExecutor originalRunner) {
+        this.taskId=Objects.requireNonNull(taskId);this.officialActions=Set.copyOf(officialActions);
+        this.authority=Objects.requireNonNull(authority);this.originalRunner=Objects.requireNonNull(originalRunner);
+    }
+    @Override public int order(){return Integer.MIN_VALUE;}
+    @Override public Flux<AgentEvent> onAgent(Agent agent,RuntimeContext context,AgentInput input,Function<AgentInput,Flux<AgentEvent>> next) {
+        return Flux.defer(()->{
+            authority.requireAuthorized();var task=context.get(AgentTaskToolContext.class);
+            if(task==null||!taskId.equals(task.taskId())||context.get(AgentTaskOutcome.State.class)==null)
+                return Flux.error(new SecurityException("Official task context mismatch"));
+            Map<String,AgentTool> tools=new LinkedHashMap<>();
+            var names=new LinkedHashSet<>(officialActions);names.add("task.submit_result");
+            names.remove("task.complete");names.remove("task.fail");
+            for(String name:names){AgentTool tool=agent.getToolkit().getTool(name);if(tool!=null)tools.put(name,tool);}
+            if(!tools.containsKey("task.submit_result"))return Flux.error(new IllegalStateException("Official task outcome tool missing"));
+            return originalRunner.execute(new PreparedTask(input,context,Map.copyOf(tools))).map(AgentResultEvent::new).cast(AgentEvent.class).flux();
+        });
+    }
+}
