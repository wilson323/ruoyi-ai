+package org.ruoyi.ipd.agent.kernel;
+
+import io.agentscope.core.agent.RuntimeContext;
+import io.agentscope.harness.agent.memory.session.SessionTree;
+import io.agentscope.harness.agent.workspace.WorkspaceManager;
+
+/** 恢复官方 canonical session cache；调用方必须先核真实 person/project 访问权。 */
+public final class ProjectAgentSessionRestore {
+    private ProjectAgentSessionRestore() { }
+
+    public static void restore(WorkspaceManager manager, RuntimeContext context,
+                               String agentId, String sessionId, Runnable requireCurrentAccess) {
+        requireCurrentAccess.run();
+        if (agentId == null || !agentId.matches("[A-Za-z0-9_-]+")
+            || sessionId == null || !sessionId.matches("[A-Za-z0-9_:-]+")) {
+            throw new IllegalArgumentException("Canonical session identity is required");
+        }
+        String relative = "agents/" + agentId + "/sessions/" + sessionId + ".jsonl";
+        var tree = new SessionTree(manager.resolveSessionContextFile(context, agentId, sessionId),
+            manager.getWorkspace(), manager.getFilesystem(), manager.getIndex(), relative)
+            .setRuntimeContext(context);
+        tree.load();
+        tree.syncFromLog();
+    }
+}
