+
+    public static ProjectAgentPinnedFoundationRuntime open(String image,
+        ProjectAgentFoundationTools.Scope scope) throws Exception {
+        Objects.requireNonNull(scope);
+        if (image == null || image.isBlank()) {
+            throw new IllegalArgumentException("Sandbox image is required");
+        }
+        var options = new DockerSandboxClientOptions().image(image).workspaceRoot("/workspace")
+            .network("none").additionalRunArgs("--cap-drop=ALL", "--security-opt=no-new-privileges",
+                "--mount", "type=volume,source=" + scope.volumeName() + ",target=/workspace");
+        Sandbox sandbox = new DockerSandboxClient().create(new WorkspaceSpec(), new NoopSnapshotSpec(), options);
+        try {
+            sandbox.start();
+            return new ProjectAgentPinnedFoundationRuntime(sandbox);
+        } catch (Exception error) {
+            sandbox.shutdown();
+            throw error;
+        }
+    }
+
+    public PinnedSandboxFilesystem filesystem() {
+        if (closed) { throw new IllegalStateException("Sandbox runtime is closed"); }
+        return filesystem;
+    }
+
+    /** SDK 2.0.3 只有全进程 quiescence API；超时明确失败，保持容器供后续排空与恢复。 */
+    @Override
+    public synchronized void close() throws Exception {
+        if (closed) { return; }
+        if (!MemoryBackgroundTasks.awaitQuiescence(30, TimeUnit.SECONDS)) {
+            throw new IllegalStateException("Background memory tasks are still active; sandbox retained");
+        }
+        sandbox.shutdown();
+        closed = true;
+    }
+}
