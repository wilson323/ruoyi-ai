+package org.ruoyi.ipd.agent.servicebridge;
+import io.agentscope.core.state.*;
+import io.agentscope.extensions.aistio.adapter.*;
+import java.util.*;
+/** Trusted host recovery adapter over the existing official state store; not a Task endpoint. */
+public final class ProjectAgentPreparedTaskDispatch {
+ public record Identity(String deploymentId,String tenantId,Long personId,Long projectId,String taskId,String attemptId,long generation,String idempotencyKey) {
+  public Identity { Objects.requireNonNull(deploymentId);Objects.requireNonNull(tenantId);Objects.requireNonNull(personId);Objects.requireNonNull(projectId);Objects.requireNonNull(taskId);Objects.requireNonNull(attemptId);Objects.requireNonNull(idempotencyKey); }
+ }
+ public record Receipt(Identity identity,String phase,String outcomeHash) implements State {}
+ public interface TrustedDeployment { void authorize(Identity identity); ProjectAgentOfficialTaskRelay.PreparedTask rebuild(Identity identity); }
+ private final AgentStateStore store;private final TrustedDeployment deployment;
+ public ProjectAgentPreparedTaskDispatch(AgentStateStore store,TrustedDeployment deployment){this.store=Objects.requireNonNull(store);this.deployment=Objects.requireNonNull(deployment);if(!store.supportsVersioning())throw new IllegalArgumentException("Versioned official state store required");}
+ private String user(Identity i){return "ipd:"+i.tenantId()+":"+i.projectId()+":"+i.personId();}
+ private static final String KEY="ipd_prepared_task_dispatch";
+ private VersionedState<Receipt> load(Identity i){deployment.authorize(i);var v=store.getVersioned(user(i),i.idempotencyKey(),KEY,Receipt.class);if(v.value()!=null&&!v.value().identity().equals(i))throw new SecurityException("Prepared task identity collision");return v;}
+ /** Called only by verified server deployment; credentials and tool objects never enter this state. */
+ void register(Identity i){var v=load(i);if(v.value()!=null)return;if(store.saveIfVersion(user(i),i.idempotencyKey(),KEY,new Receipt(i,"REGISTERED",""),v.version())==AgentStateStore.UNVERSIONED){if(load(i).value()==null)throw new IllegalStateException("Prepared task registration conflict");}}
+ public ProjectAgentOfficialTaskRelay.PreparedTask recover(Identity i){var v=load(i);if(v.value()==null)throw new SecurityException("Prepared task not registered");if(!v.value().phase().equals("REGISTERED"))throw new IllegalStateException("Prepared task outcome already claimed");var task=deployment.rebuild(i);deployment.authorize(i);var ctx=task.officialContext().get(AgentTaskToolContext.class);if(ctx==null||!i.taskId().equals(ctx.taskId())||ctx.taskToken()==null||ctx.taskToken().isBlank()||task.officialContext().get(AgentTaskOutcome.State.class)==null)throw new SecurityException("Rebuilt task context mismatch");return task;}
+ /** Single CAS winner can hand the original outcome to official finish; crash after claim needs reconciliation. */
+ public Optional<AgentTaskOutcome> claim(Identity i,AgentTaskOutcome.State state){var v=load(i);if(v.value()==null||!v.value().phase().equals("REGISTERED"))return Optional.empty();var outcome=state.take();if(outcome==null)return Optional.empty();deployment.authorize(i);var receipt=new Receipt(i,"OUTCOME_CLAIMED",hash(outcome.toString()));long next=store.saveIfVersion(user(i),i.idempotencyKey(),KEY,receipt,v.version());return next==AgentStateStore.UNVERSIONED?Optional.empty():Optional.of(outcome);}
+ private static String hash(String s){try{return java.util.HexFormat.of().formatHex(java.security.MessageDigest.getInstance("SHA-256").digest(s.getBytes(java.nio.charset.StandardCharsets.UTF_8)));}catch(java.security.NoSuchAlgorithmException x){throw new IllegalStateException(x);}}
+}
