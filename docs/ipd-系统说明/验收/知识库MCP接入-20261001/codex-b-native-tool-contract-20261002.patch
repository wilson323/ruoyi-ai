+    public static Path authorizedPath(Path base, String relative) throws IOException {
+        Path input = Path.of(relative);
+        if (input.isAbsolute() || relative.isBlank()) throw new IllegalArgumentException("relative workspace path required");
+        for (Path part : input) if (part.toString().equals("..")) throw new IllegalArgumentException("workspace traversal rejected");
+        Path canonical = base.toRealPath(LinkOption.NOFOLLOW_LINKS);
+        if (Files.isSymbolicLink(base)) throw new IllegalStateException("workspace symbolic link rejected");
+        Path resolved = canonical.resolve(input).normalize();
+        if (!resolved.startsWith(canonical)) throw new IllegalArgumentException("workspace path rejected");
+        Path current = canonical;
+        for (Path part : canonical.relativize(resolved)) {
+            current = current.resolve(part);
+            if (Files.isSymbolicLink(current)) throw new IllegalStateException("workspace symbolic link rejected");
+        }
+        return resolved;
+    }
