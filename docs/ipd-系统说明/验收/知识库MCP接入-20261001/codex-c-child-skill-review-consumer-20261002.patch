+package org.ruoyi.ipd.agent.kernel;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import io.agentscope.core.agent.RuntimeContext;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.HexFormat;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.function.Consumer;
+import reactor.core.publisher.Mono;
+
+/** 子草案读取与可信 root owner 授权分离；只写可回读的待批准 receipt。 */
+public final class ProjectAgentChildSkillReview {
+    private final ProjectAgentChildLineageRegistry lineage;
+    private final Runnable requireCurrentAccess;
+    private final Consumer<RuntimeContext> requireRootOwner;
+    private final String projectId;
+    private final String personId;
+    private final String runId;
+
+    public ProjectAgentChildSkillReview(ProjectAgentChildLineageRegistry lineage, Runnable requireCurrentAccess,
+        Consumer<RuntimeContext> requireRootOwner, String projectId, String personId, String runId) {
+        this.lineage = java.util.Objects.requireNonNull(lineage);
+        this.requireCurrentAccess = java.util.Objects.requireNonNull(requireCurrentAccess);
+        this.requireRootOwner = java.util.Objects.requireNonNull(requireRootOwner);
+        this.projectId = projectId;
+        this.personId = personId;
+        this.runId = runId;
+    }
+
+    public Mono<Void> review(ProjectAgentChildConsumers.ChildInvocation invocation, String skillName) {
+        return Mono.fromRunnable(() -> {
+            requireCurrentAccess.run();
+            lineage.requireKnown(invocation.child(), invocation.childContext());
+            requireRootOwner.accept(invocation.ownerContext());
+            if (skillName == null || !skillName.matches("[A-Za-z0-9_-]+")) {
+                throw new IllegalArgumentException("Invalid skill review identity");
+            }
+            var manager = invocation.child().getWorkspaceManager();
+            var filesystem = manager.getFilesystem();
+            var context = invocation.childContext();
+            String root = "skills/_drafts/" + skillName;
+            var paths = filesystem.glob(context, "**/*", root);
+            if (!paths.isSuccess()) { throw new IllegalStateException("Official draft resources cannot be listed"); }
+            Map<String, String> resources = new java.util.TreeMap<>();
+            for (var file : paths.matches()) {
+                if (file.isDirectory() || file.path().contains("/.ipd-review-")) { continue; }
+                var raw = filesystem.read(context, file.path(), 0, 0);
+                if (!raw.isSuccess() || raw.fileData() == null || raw.fileData().content() == null) {
+                    throw new IllegalStateException("Official draft resource cannot be read");
+                }
+                resources.put(file.path(), digest(raw.fileData().content()));
+            }
+            var body = filesystem.read(context, root + "/SKILL.md", 0, 0);
+            if (!body.isSuccess() || body.fileData() == null || body.fileData().content() == null) {
+                throw new IllegalStateException("Official draft cannot be read");
+            }
+            String hash = digest(body.fileData().content());
+            String receiptPath = root + "/.ipd-review-" + runId + "-" + hash + ".json";
+            Map<String, Object> receipt = new LinkedHashMap<>();
+            receipt.put("status", "PENDING_OWNER_APPROVAL"); receipt.put("skillName", skillName);
+            receipt.put("sha256", hash); receipt.put("resourceSha256", resources);
+            receipt.put("projectId", projectId); receipt.put("personId", personId); receipt.put("runId", runId);
+            receipt.put("parentSession", invocation.parentSession());
+            receipt.put("childSession", context.getSessionId()); receipt.put("draftPath", root);
+            try {
+                String content = new ObjectMapper().writeValueAsString(receipt);
+                requireCurrentAccess.run();
+                requireRootOwner.accept(invocation.ownerContext());
+                lineage.requireKnown(invocation.child(), context);
+                var existing = filesystem.read(context, receiptPath, 0, 0);
+                if (!existing.isSuccess()) { manager.writeDraftSkillFile(context, receiptPath, content); }
+                var stored = filesystem.read(context, receiptPath, 0, 0);
+                if (!stored.isSuccess() || stored.fileData() == null || !content.equals(stored.fileData().content())) {
+                    throw new IllegalStateException("Skill owner review receipt cannot be verified");
+                }
+            } catch (RuntimeException e) { throw e; }
+            catch (Exception e) { throw new IllegalStateException("Skill owner review receipt cannot be verified", e); }
+        });
+    }
+
+    private static String digest(String content) {
+        try { return HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256")
+            .digest(content.getBytes(StandardCharsets.UTF_8))); }
+        catch (Exception e) { throw new IllegalStateException("Skill digest failed", e); }
+    }
+}
