+package org.ruoyi.ipd.agent.kernel;
+
+import io.agentscope.core.agent.RuntimeContext;
+import io.agentscope.core.skill.AgentSkill;
+import io.agentscope.harness.agent.skill.curator.SkillCandidate;
+import io.agentscope.harness.agent.skill.curator.SkillPromotionGate;
+import io.agentscope.harness.agent.skill.curator.SkillVisibilityFilter;
+import reactor.core.publisher.Mono;
+import java.util.List;
+import java.util.Objects;
+
+/** Official SDK extension adapter; approvals must come from trusted business authority. */
+public final class ProjectAgentSkillAuthorityAdapters implements SkillVisibilityFilter, SkillPromotionGate {
+    public interface OwnerApprovalAuthority {
+        /** Verify exact body/version/resources and scope against a trusted published approval. */
+        boolean approved(AgentSkill skill, RuntimeContext context);
+        /** Review the exact draft; never infer approval from its name or self-authored metadata. */
+        Mono<PromotionDecision> review(SkillCandidate candidate, RuntimeContext context);
+    }
+    private final ProjectAgentRuntimeAccess access;
+    private final OwnerApprovalAuthority authority;
+    private final String userId;
+    private final String sessionId;
+
+    public ProjectAgentSkillAuthorityAdapters(ProjectAgentRuntimeAccess access,
+            OwnerApprovalAuthority authority, String userId, String sessionId) {
+        this.access = Objects.requireNonNull(access);
+        this.authority = Objects.requireNonNull(authority);
+        this.userId = Objects.requireNonNull(userId);
+        this.sessionId = Objects.requireNonNull(sessionId);
+    }
+    private void requireContext(RuntimeContext context) {
+        if (context == null || !userId.equals(context.getUserId())
+                || !sessionId.equals(context.getSessionId())) {
+            throw new SecurityException("Skill authority context mismatch");
+        }
+        access.requireAuthorized();
+    }
+    @Override public List<AgentSkill> filter(List<AgentSkill> candidates, RuntimeContext context) {
+        requireContext(context);
+        return candidates == null ? List.of() : candidates.stream().filter(Objects::nonNull)
+            .filter(skill -> authority.approved(skill, context)).toList();
+    }
+    @Override public Mono<PromotionDecision> review(SkillCandidate candidate, RuntimeContext context) {
+        return Mono.defer(() -> {
+            requireContext(context);
+            return Objects.requireNonNull(authority.review(Objects.requireNonNull(candidate), context));
+        });
+    }
+}
