+        try{return "service-"+HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(
+            (task.agentTaskId()+":"+task.attemptId()+":"+task.generation()).getBytes(StandardCharsets.UTF_8)));}
+        catch(java.security.NoSuchAlgorithmException e){throw new IllegalStateException(e);}
+    }
+}
