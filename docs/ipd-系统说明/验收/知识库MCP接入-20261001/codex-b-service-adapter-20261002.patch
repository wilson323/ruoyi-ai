+/** Official HTTP registration factory; constructing config performs no registration. */
+public final class ProjectAgentServiceRegistration {
+    public interface BootstrapCredential { String resolve(); }
+    private ProjectAgentServiceRegistration() { }
+    public static AistioConfig config(String controlPlane, String callbackOrigin, String tenant,
+            String namespace, String stableInstanceKey, int contractPort, Path eventJournal,
+            BootstrapCredential credential) {
+        requireLocalOrigin(controlPlane);requireLocalOrigin(callbackOrigin);
+        if(tenant==null||tenant.isBlank()||namespace==null||namespace.isBlank()
+            ||stableInstanceKey==null||stableInstanceKey.isBlank()||contractPort<1||contractPort>65535)
+            throw new IllegalArgumentException("Trusted registration scope required");
+        String token=Objects.requireNonNull(credential.resolve());if(token.isBlank())throw new IllegalArgumentException("Registration credential missing");
+        return AistioConfig.builder("ipd-project-agent").controlPlaneHttp(controlPlane).tenant(tenant)
+            .namespace(namespace).instanceKey(stableInstanceKey).internalToken(token)
+            .contractHttpHost("127.0.0.1").contractHttpPort(contractPort).publicBaseUrl(callbackOrigin)
+            .eventJournalDir(Objects.requireNonNull(eventJournal).toAbsolutePath().normalize().toString())
+            .enableEvents(true).startHttp(true).startGrpc(false).startHttpRegister(true).build();
+    }
+    /** Only call after local Service setup and runtime integration have been authorized. */
+    public static SessionBridge instrument(ProjectAgentRunService target,ProjectAgentServiceAdapter adapter,AistioConfig config){
+        return Aistio.instrument(target,config,adapter);
+    }
+    private static void requireLocalOrigin(String value){
+        URI uri=URI.create(Objects.requireNonNull(value));if(!"http".equals(uri.getScheme())
+            ||!java.util.Set.of("localhost","127.0.0.1","host.docker.internal").contains(uri.getHost())
+            ||uri.getRawUserInfo()!=null||uri.getRawQuery()!=null||uri.getRawFragment()!=null
+            ||!(uri.getPath()==null||uri.getPath().isEmpty()||"/".equals(uri.getPath())))
+            throw new IllegalArgumentException("Approved local Service origin required");
+    }
+}
