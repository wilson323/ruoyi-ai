+                boolean purpose = clause.matches("^(?:用途|目的裁剪|目的声明).*")
+                    || clause.matches("^(?:必须(?:先)?声明|必需(?:条件|前置)|未声明|阻塞(?:\\s*C02|\\s*步骤)).*");
+                if (purpose && clause.matches(".*(?:阻塞(?:\\s*C02)?|必须(?:先|补|声明)|必需(?:条件|前置)|才能继续).*")) return true;
+            }
+        }
+        return false;
     }
 
