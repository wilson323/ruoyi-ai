+package org.ruoyi.ipd.agent.kernel;
+
+import io.agentscope.core.agent.RuntimeContext;
+import io.agentscope.harness.agent.filesystem.AbstractFilesystem;
+import io.agentscope.harness.agent.filesystem.model.EditResult;
+import io.agentscope.harness.agent.filesystem.model.FileDownloadResponse;
+import io.agentscope.harness.agent.filesystem.model.FileInfo;
+import io.agentscope.harness.agent.filesystem.model.FileUploadResponse;
+import io.agentscope.harness.agent.filesystem.model.GlobResult;
+import io.agentscope.harness.agent.filesystem.model.GrepMatch;
+import io.agentscope.harness.agent.filesystem.model.GrepResult;
+import io.agentscope.harness.agent.filesystem.model.LsResult;
+import io.agentscope.harness.agent.filesystem.model.ReadResult;
+import io.agentscope.harness.agent.filesystem.model.WriteResult;
+
+import java.util.List;
+import java.util.Map;
+
+/** 官方 CompositeFilesystem 路由的挂载路径适配；全部 I/O 委托同一官方 filesystem。 */
+public final class ProjectAgentSandboxPathFilesystem implements AbstractFilesystem {
+    private final AbstractFilesystem delegate;
+    private final String root;
+
+    public ProjectAgentSandboxPathFilesystem(AbstractFilesystem delegate, String root) {
+        AbstractFilesystem.validatePath(root);
+        if (!root.startsWith("/") || root.equals("/")) {
+            throw new IllegalArgumentException("A fixed mounted directory is required");
+        }
+        this.delegate = java.util.Objects.requireNonNull(delegate);
+        this.root = root.replaceAll("/+$", "");
+    }
+
+    private String physical(String path) {
+        String value = path == null || path.isBlank() ? "/" : path;
+        AbstractFilesystem.validatePath(value);
+        if (value.startsWith("/workspace/")) { value = value.substring("/workspace/".length()); }
+        return root + "/" + value.replaceAll("^/+", "");
+    }
+
+    private String logical(String path) {
+        if (path == null) { return null; }
+        return path.startsWith(root + "/") ? path.substring(root.length()) : path;
+    }
+
+    private FileInfo logical(FileInfo file) {
+        return new FileInfo(logical(file.path()), file.isDirectory(), file.size(), file.modifiedAt());
+    }
+
+    public LsResult ls(RuntimeContext context, String path) {
+        var result = delegate.ls(context, physical(path));
+        return result.isSuccess() ? LsResult.success(result.entries().stream().map(this::logical).toList()) : result;
+    }
+    public ReadResult read(RuntimeContext context, String path, int offset, int limit) {
+        return delegate.read(context, physical(path), offset, limit);
+    }
+    public WriteResult write(RuntimeContext context, String path, String content) {
+        var result = delegate.write(context, physical(path), content);
+        return new WriteResult(logical(result.path()), result.error());
+    }
+    public EditResult edit(RuntimeContext context, String path, String oldText, String newText, boolean all) {
+        var result = delegate.edit(context, physical(path), oldText, newText, all);
+        return new EditResult(logical(result.path()), result.error(), result.occurrences());
+    }
+    public GrepResult grep(RuntimeContext context, String pattern, String path, String glob) {
+        var result = delegate.grep(context, pattern, physical(path), glob);
+        return result.isSuccess() ? GrepResult.success(result.matches().stream().map(match ->
+            new GrepMatch(logical(match.path()), match.line(), match.text())).toList()) : result;
+    }
+    public GlobResult glob(RuntimeContext context, String pattern, String path) {
+        var result = delegate.glob(context, pattern, physical(path));
+        return result.isSuccess() ? GlobResult.success(result.matches().stream().map(this::logical).toList()) : result;
+    }
+    public List<FileUploadResponse> uploadFiles(RuntimeContext context, List<Map.Entry<String, byte[]>> files) {
+        return delegate.uploadFiles(context, files.stream().map(file ->
+            Map.entry(physical(file.getKey()), file.getValue())).toList()).stream().map(result ->
+            new FileUploadResponse(logical(result.path()), result.error())).toList();
+    }
+    public List<FileDownloadResponse> downloadFiles(RuntimeContext context, List<String> paths) {
+        return delegate.downloadFiles(context, paths.stream().map(this::physical).toList()).stream().map(result ->
+            new FileDownloadResponse(logical(result.path()), result.content(), result.error())).toList();
+    }
+    public WriteResult delete(RuntimeContext context, String path) {
+        var result = delegate.delete(context, physical(path));
+        return new WriteResult(logical(result.path()), result.error());
+    }
+    public WriteResult move(RuntimeContext context, String from, String to) {
+        var result = delegate.move(context, physical(from), physical(to));
+        return new WriteResult(logical(result.path()), result.error());
+    }
+    public boolean exists(RuntimeContext context, String path) {
+        return delegate.exists(context, physical(path));
+    }
+}
