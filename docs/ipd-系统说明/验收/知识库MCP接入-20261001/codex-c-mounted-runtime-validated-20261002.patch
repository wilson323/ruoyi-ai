+package org.ruoyi.ipd.agent.kernel;
+
+import io.agentscope.harness.agent.filesystem.AbstractFilesystem;
+import io.agentscope.harness.agent.filesystem.RoutedSandboxFilesystem;
+import io.agentscope.harness.agent.filesystem.sandbox.PinnedSandboxFilesystem;
+import io.agentscope.harness.agent.memory.MemoryBackgroundTasks;
+import io.agentscope.harness.agent.sandbox.Sandbox;
+import io.agentscope.harness.agent.sandbox.WorkspaceSpec;
+import io.agentscope.harness.agent.sandbox.impl.docker.DockerSandboxClient;
+import io.agentscope.harness.agent.sandbox.impl.docker.DockerSandboxClientOptions;
+import io.agentscope.harness.agent.sandbox.snapshot.NoopSnapshotSpec;
+
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.TimeUnit;
+
+/** 执行容器独有 run 可写盘，历史/记忆只读挂载；原生记忆 API 走单独官方可写 backend。 */
+public final class ProjectAgentMountedFoundationRuntime implements AutoCloseable {
+    private final ProjectAgentFoundationTools.Scope scope;
+    private final String image;
+    private final Sandbox execution;
+    private final Sandbox memory;
+    private final RoutedSandboxFilesystem filesystem;
+    private boolean closed;
+
+    private ProjectAgentMountedFoundationRuntime(ProjectAgentFoundationTools.Scope scope, String image,
+                                                  Sandbox execution, Sandbox memory) {
+        this.scope = scope;
+        this.image = image;
+        this.execution = execution;
+        this.memory = memory;
+        var run = new PinnedSandboxFilesystem(execution);
+        var persistent = new PinnedSandboxFilesystem(memory);
+        var root = new ProjectAgentSandboxPathFilesystem(persistent, "/workspace");
+        var daily = new ProjectAgentSandboxPathFilesystem(persistent, "/workspace/memory");
+        var skills = new ProjectAgentSandboxPathFilesystem(persistent, "/workspace/skills");
+        var sessions = new ProjectAgentSandboxPathFilesystem(persistent, "/workspace/.agentscope");
+        this.filesystem = new RoutedSandboxFilesystem(run, Map.of(
+            "/MEMORY.md", root, "/workspace/MEMORY.md", root,
+            "/memory/", daily, "/workspace/memory/", daily,
+            "/skills/", skills, "/workspace/skills/", skills,
+            "/.agentscope/", sessions, "/workspace/.agentscope/", sessions));
+    }
+
+    public static ProjectAgentMountedFoundationRuntime open(String image,
+        ProjectAgentFoundationTools.Scope scope) throws Exception {
+        java.util.Objects.requireNonNull(scope);
+        if (image == null || image.isBlank()) { throw new IllegalArgumentException("Sandbox image is required"); }
+        String base = scope.volumeName();
+        Sandbox execution = create(image, "/workspace", "--mount", "type=volume,source=" + base
+            + "-run-" + scope.runId() + ",target=/workspace", "--mount", "type=volume,source=" + base
+            + "-history,target=/history,readonly", "--mount", "type=volume,source=" + base
+            + "-memory,target=/memory,readonly");
+        Sandbox memory = create(image, "/workspace", "--mount", "type=volume,source=" + base
+            + "-memory,target=/workspace");
+        try {
+            execution.start();
+            memory.start();
+            var initialized = memory.exec(null, "mkdir -p /workspace/memory /workspace/skills /workspace/.agentscope", 10);
+            if (!initialized.ok()) { throw new IllegalStateException("Memory directories could not be initialized"); }
+            return new ProjectAgentMountedFoundationRuntime(scope, image, execution, memory);
+        } catch (Exception error) {
+            try { execution.shutdown(); } catch (Exception cleanup) { error.addSuppressed(cleanup); }
+            try { memory.shutdown(); } catch (Exception cleanup) { error.addSuppressed(cleanup); }
+            throw error;
+        }
+    }
+
+    private static Sandbox create(String image, String root, String... mounts) throws Exception {
+        String[] args = new String[mounts.length + 2];
+        args[0] = "--cap-drop=ALL";
+        args[1] = "--security-opt=no-new-privileges";
+        System.arraycopy(mounts, 0, args, 2, mounts.length);
+        var options = new DockerSandboxClientOptions().image(image).workspaceRoot(root)
+            .network("none").additionalRunArgs(args);
+        options.setEnvironment(Map.of());
+        return new DockerSandboxClient().create(new WorkspaceSpec(), new NoopSnapshotSpec(), options);
+    }
+
+    public RoutedSandboxFilesystem filesystem() {
+        if (closed) { throw new IllegalStateException("Sandbox runtime is closed"); }
+        return filesystem;
+    }
+
+    public Set<String> volumeNames() {
+        return Set.of(scope.volumeName() + "-run-" + scope.runId(),
+            scope.volumeName() + "-history", scope.volumeName() + "-memory");
+    }
+
+    private void exportHistory() throws Exception {
+        String target = "/history/runs/" + scope.runId();
+        Sandbox exporter = create(image, "/history", "--mount", "type=volume,source="
+            + scope.volumeName() + "-run-" + scope.runId() + ",target=/run,readonly", "--mount",
+            "type=volume,source=" + scope.volumeName() + "-history,target=/history");
+        try {
+            exporter.start();
+            var result = exporter.exec(null, "mkdir -p /history/runs && if [ -d " + target
+                + " ]; then diff -qr /run " + target + "; else cp -a /run " + target + "; fi", 30);
+            if (!result.ok()) { throw new IllegalStateException("Run history export failed or conflicts with its existing snapshot"); }
+        } finally {
+            exporter.shutdown();
+        }
+    }
+
+    @Override
+    public synchronized void close() throws Exception {
+        if (closed) { return; }
+        if (!MemoryBackgroundTasks.awaitQuiescence(30, TimeUnit.SECONDS)) {
+            throw new IllegalStateException("Background memory tasks are still active; runtime retained");
+        }
+        exportHistory();
+        execution.shutdown();
+        memory.shutdown();
+        closed = true;
+    }
+}
