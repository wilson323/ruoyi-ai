+package org.ruoyi.ipd.agent.servicebridge;
+
+import io.agentscope.extensions.aistio.FrameworkAdapter;
+import io.agentscope.extensions.aistio.adapter.AgentScopeAdapter;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Proxy;
+import java.util.Objects;
+import java.util.function.LongFunction;
+import reactor.core.publisher.Mono;
+
+/** Complete official adapter forwarding. Host supplies the actual run adapter; never builds another agent. */
+public final class ProjectAgentServiceNativeSessions {
+    public record NativeRun(AgentScopeAdapter adapter,String sessionId) {
+        public NativeRun { Objects.requireNonNull(adapter);if(sessionId==null||sessionId.isBlank())throw new IllegalArgumentException("Native session required"); }
+    }
+    private ProjectAgentServiceNativeSessions() { }
+    public static FrameworkAdapter bind(ProjectAgentServiceAuthority authority,
+            LongFunction<NativeRun> actualRunAdapters) {
+        Objects.requireNonNull(authority);Objects.requireNonNull(actualRunAdapters);
+        return (FrameworkAdapter)Proxy.newProxyInstance(FrameworkAdapter.class.getClassLoader(),
+            new Class<?>[]{FrameworkAdapter.class},(proxy,method,args)->{
+                if(method.getDeclaringClass()==Object.class){return switch(method.getName()){
+                    case "toString"->"IPD scoped official adapter";case "hashCode"->System.identityHashCode(proxy);
+                    case "equals"->proxy==args[0];default->throw new IllegalStateException();};}
+                java.util.function.Supplier<Object> invoke=()->{
+                    var bound=args!=null&&args.length>0&&args[0] instanceof String session
+                        ?authority.resolve(session):authority.registrationScope();
+                    var nativeRun=Objects.requireNonNull(actualRunAdapters.apply(bound.runId()),"Actual run native adapter unavailable");
+                    Object[] forwarded=args==null?null:args.clone();
+                    if(forwarded!=null&&forwarded.length>0&&forwarded[0] instanceof String)forwarded[0]=nativeRun.sessionId();
+                    try{return method.invoke(nativeRun.adapter(),forwarded);}catch(InvocationTargetException e){
+                        if(e.getCause() instanceof RuntimeException r)throw r;throw new IllegalStateException("Official adapter invocation failed",e.getCause());
+                    }catch(ReflectiveOperationException e){throw new IllegalStateException("Official adapter contract mismatch",e);}
+                };
+                // Every deferred query revalidates Person/project membership at subscription time.
+                if(Mono.class.isAssignableFrom(method.getReturnType()))return Mono.defer(()->(Mono<?>)invoke.get());
+                return invoke.get();
+            });
+    }
+}
