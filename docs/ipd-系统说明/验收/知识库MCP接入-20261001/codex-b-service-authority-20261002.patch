+package org.ruoyi.ipd.agent.servicebridge;
+
+import io.agentscope.core.state.AgentStateStore;
+import io.agentscope.extensions.aistio.FrameworkAdapter;
+import io.agentscope.extensions.aistio.transport.CollaborationClient;
+import org.ruoyi.ipd.agent.service.ProjectAgentRunService;
+import org.ruoyi.ipd.agent.store.AgentRunStore;
+import org.ruoyi.ipd.mapper.PersonMapper;
+import org.ruoyi.ipd.service.IpdCopilotAccess;
+import java.time.Duration;
+import java.util.function.LongFunction;
+
+/** Typed bean factory for host Configuration. Construction performs no Service registration/network call. */
+public final class ProjectAgentServiceBindingsConfiguration {
+    private ProjectAgentServiceBindingsConfiguration() { }
+    public record Bindings(ProjectAgentServiceAuthority authority,FrameworkAdapter nativeAdapter,
+            ProjectAgentServiceTaskStarter taskStarter,ProjectAgentServiceAdapter adapter) { }
+    public static Bindings create(ProjectAgentServiceAuthority.Deployment approvedDeployment,
+            PersonMapper people,IpdCopilotAccess access,ProjectAgentRunService runs,AgentRunStore runStore,
+            AgentStateStore officialStateStore,CollaborationClient officialCollaboration,
+            LongFunction<ProjectAgentServiceNativeSessions.NativeRun> actualRunAdapters,
+            Duration poll,Duration deadline) {
+        var authority=new ProjectAgentServiceAuthority(approvedDeployment,people,access,runs,runStore,officialStateStore);
+        var nativeAdapter=ProjectAgentServiceNativeSessions.bind(authority,actualRunAdapters);
+        var tasks=new ProjectAgentServiceTaskStarter(runs,access,officialCollaboration,authority,poll,deadline);
+        return new Bindings(authority,nativeAdapter,tasks,new ProjectAgentServiceAdapter(runs,access,authority,tasks,nativeAdapter));
+    }
+}
