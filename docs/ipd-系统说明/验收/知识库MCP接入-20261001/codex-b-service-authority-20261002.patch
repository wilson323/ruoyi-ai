+package org.ruoyi.ipd.agent.servicebridge;
+
+import io.agentscope.core.state.AgentStateStore;
+import io.agentscope.core.state.State;
+import io.agentscope.extensions.aistio.model.AgentTaskAssignment;
+import org.ruoyi.ipd.agent.dto.AgentRunCreateReq;
+import org.ruoyi.ipd.agent.store.AgentRunStore;
+import org.ruoyi.ipd.agent.service.ProjectAgentRunService;
+import org.ruoyi.ipd.mapper.PersonMapper;
+import org.ruoyi.ipd.security.IpdActor;
+import org.ruoyi.ipd.service.IpdCopilotAccess;
+import java.util.Objects;
+
+/** Server deployment binding, never populated from task payload or Service endpoint parameters. */
+public final class ProjectAgentServiceAuthority implements ProjectAgentServiceAdapter.TrustedSessions,
+        ProjectAgentServiceTaskStarter.TrustedBindingResolver {
+    public record Deployment(Long personId, Long projectId, Long registrationRunId,
+                             AgentRunCreateReq approvedRequest) {
+        public Deployment { Objects.requireNonNull(personId);Objects.requireNonNull(projectId);
+            Objects.requireNonNull(registrationRunId);Objects.requireNonNull(approvedRequest); }
+    }
+    public record SessionIndex(Long personId, Long projectId, Long runId) implements State { }
+    private static final String KEY="ipd_service_binding";
+    private final Deployment deployment;
+    private final PersonMapper people;
+    private final IpdCopilotAccess access;
+    private final ProjectAgentRunService runs;
+    private final AgentRunStore runStore;
+    private final AgentStateStore state;
+    public ProjectAgentServiceAuthority(Deployment deployment,PersonMapper people,IpdCopilotAccess access,
+            ProjectAgentRunService runs,AgentRunStore runStore,AgentStateStore state) {
+        this.deployment=Objects.requireNonNull(deployment);this.people=Objects.requireNonNull(people);
+        this.access=Objects.requireNonNull(access);this.runs=Objects.requireNonNull(runs);
+        this.runStore=Objects.requireNonNull(runStore);this.state=Objects.requireNonNull(state);
+        registrationScope();
+    }
+    public String userId(){return "ipd:"+deployment.projectId()+":"+deployment.personId();}
+    private IpdActor actor(){var person=people.selectById(deployment.personId());
+        if(person==null||!deployment.personId().equals(person.getId()))throw new SecurityException("Service Person unavailable");
+        var actor=new IpdActor(person.getId(),person.getName(),person.getPersonType(),person.getGroupId());
+        access.requireVisible(actor,deployment.projectId());return actor;}
+    private ProjectAgentServiceAdapter.SessionBinding own(Long id){var actor=actor();var run=runs.get(actor,id);
+        if(!String.valueOf(deployment.projectId()).equals(run.projectId()))throw new SecurityException("Service run project mismatch");
+        return new ProjectAgentServiceAdapter.SessionBinding(actor,deployment.projectId(),id);}
+    /** Called only by authenticated host registration, with an existing owned run. No HTTP endpoint. */
+    public synchronized void bindExistingSession(String sessionId,Long runId){validateSession(sessionId);var own=own(runId);
+        var existing=state.get(userId(),sessionId,KEY,SessionIndex.class);
+        if(existing.isPresent())throw new IllegalStateException("Service session already bound");
+        state.save(userId(),sessionId,KEY,new SessionIndex(own.actor().id(),own.projectId(),runId));}
+    public ProjectAgentServiceAdapter.SessionBinding resolve(String sessionId){validateSession(sessionId);
+        var index=state.get(userId(),sessionId,KEY,SessionIndex.class).orElseThrow(()->new SecurityException("Unbound Service session"));
+        if(!deployment.personId().equals(index.personId())||!deployment.projectId().equals(index.projectId()))throw new SecurityException("Service session scope mismatch");
+        return own(index.runId());}
+    public AgentRunCreateReq conversationRequest(String sessionId,String content){resolve(sessionId);
+        if(content==null||content.isBlank())throw new IllegalArgumentException("Conversation input required");
+        var r=deployment.approvedRequest();return new AgentRunCreateReq(r.capabilityPackCode(),r.capabilityPackVersion(),r.modelConfigId(),r.skillNames(),r.toolIds(),r.actionCode(),content,
+            "service-turn-"+java.util.UUID.randomUUID(),r.productLineId(),r.requirementId(),r.previousRunId(),r.targetDocumentId(),r.baseVersionId());}
+    public ProjectAgentServiceAdapter.SessionBinding registrationScope(){return own(deployment.registrationRunId());}
+    public synchronized void onCreated(String sessionId,Long runId){resolve(sessionId);var own=own(runId);
+        state.save(userId(),sessionId,KEY,new SessionIndex(own.actor().id(),own.projectId(),runId));}
+    public ProjectAgentServiceTaskStarter.Binding resolve(AgentTaskAssignment assignment){var bound=resolve(assignment.sessionId());
+        String tenant=access.requireVisible(bound.actor(),bound.projectId());
+        var prior=runStore.findByIdempotencyKey(tenant,bound.actor().id(),ProjectAgentServiceTaskStarter.idempotencyKey(assignment));
+        Long id=prior.map(row->{own(row.getId());return row.getId();}).orElse(null);
+        return new ProjectAgentServiceTaskStarter.Binding(bound.actor(),bound.projectId(),deployment.approvedRequest(),id);}
+    public void recordRun(AgentTaskAssignment assignment,ProjectAgentServiceTaskStarter.Binding bound,Long id){
+        var actual=resolve(assignment.sessionId());if(!actual.actor().id().equals(bound.actor().id())||!actual.projectId().equals(bound.projectId()))throw new SecurityException("Task scope mismatch");onCreated(assignment.sessionId(),id);}
+    private static void validateSession(String id){if(id==null||id.isBlank()||id.length()>200||!id.matches("[A-Za-z0-9_.:-]+"))throw new SecurityException("Invalid Service session");}
+}
